---
import { Image } from 'astro:assets';
import heroImg from '../assets/hero-flower.png';
---

<section class="hero" id="top" data-nav-theme="light-text">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__bg-move" data-hero-bg>
      <Image src={heroImg} alt="" widths={[800]} sizes="100vw" loading="eager" fetchpriority="high" class="hero__img" />
    </div>
    <div class="hero__tint"></div>
  </div>

  <h1 class="hero__title h-130" data-split-lines>
    <span class="line-mask"><span>We make businesses</span></span>
    <span class="line-mask"><span>look better.</span></span>
  </h1>

  <div class="hero__intro" data-hero-fade>
    <p>We're a creative design agency turning business problems into brands, digital experiences, and ideas people actually care about.</p>
    <p>From the first big idea to the final pixel, we make things that move businesses forward.</p>
  </div>

  <div class="hero__labels label" data-hero-fade>
    <span>Brand.</span>
    <span>Digital.</span>
    <span>Creative.</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 80rem;
    color: var(--white);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .hero__bg-move { position: absolute; inset: -6% 0; will-change: transform; }
  .hero__bg-move :global(.hero__img) { width: 100%; height: 100%; object-fit: cover; }
  .hero__tint {
    position: absolute;
    inset: 0;
    background: rgba(255, 44, 160, 0.96);
    mix-blend-mode: color-dodge;
  }

  .hero__title {
    position: absolute;
    left: var(--gutter);
    top: 16rem;
    width: 136.2rem;
  }

  .hero__intro {
    position: absolute;
    left: calc(41.67% + 12.8rem);
    top: 59rem;
    width: 94.4rem;
    display: flex;
    gap: 4rem;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1.8rem;
    line-height: 2.2rem;
  }
  .hero__intro p { flex: 1 0 0; min-width: 0; }

  .hero__labels {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: 74.4rem;
    display: flex;
    justify-content: space-between;
  }

  @media (max-width: 1100px) {
    .hero { height: auto; min-height: 100svh; padding: 18rem var(--gutter) 4rem; display: flex; flex-direction: column; }
    .hero__title, .hero__intro, .hero__labels { position: static; width: auto; }
    .hero__title { font-size: 11rem; }
    .hero__intro { margin-top: auto; padding-top: 6rem; }
    .hero__labels { margin-top: 5rem; }
  }
  @media (max-width: 700px) {
    .hero__title { font-size: 8rem; letter-spacing: -0.3rem; }
    .hero__intro { flex-direction: column; gap: 2rem; font-size: 2rem; line-height: 1.3; }
  }
</style>
